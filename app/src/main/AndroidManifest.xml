<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Project1NewsApp">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".ComposeMap"
            android:exported="false"
            android:label="@string/title_activity_compose_map"
            android:theme="@style/Theme.Project1NewsApp" />
        <activity
            android:name=".GoogleMapScreen"
            android:exported="false"
            android:label="@string/title_activity_google_map_screen"
            android:theme="@style/Theme.Project1NewsApp" />
        <activity
            android:name=".TopHeadlinesScreen"
            android:exported="false"
            android:label="@string/title_activity_top_headlines"
            android:theme="@style/Theme.Project1NewsApp" />
        <activity
            android:name=".ResultsScreen"
            android:exported="false"
            android:label="@string/title_activity_results_screen"
            android:theme="@style/Theme.Project1NewsApp" />
        <activity
            android:name=".SourcesScreen"
            android:exported="false"
            android:label="@string/title_activity_sources_screen"
            android:theme="@style/Theme.Project1NewsApp" />
        <activity
            android:name=".HomeScreen"
            android:exported="false"
            android:label="@string/title_activity_home_screen"
            android:theme="@style/Theme.Project1NewsApp" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Project1NewsApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>